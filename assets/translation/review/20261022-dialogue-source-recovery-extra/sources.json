[
  {
    "id": "ADVDATA/SCRIPT/S0130.SBX#0110",
    "before": {
      "source": "「慰，亜煙握」葦唄……//淫刈亜煙鮎或亜一飲旭//解安引……"
    },
    "after": {
      "source": "「あぁ、無情」か……//どういった舞台にしたら、//いいんだろう……"
    },
    "reference": "research/legacy/original_txt/ADVDATA/SCRIPT/S0130.txt",
    "reference_sha256": "5610bad5c832c446165b3b272e427ef2e268977be11f90df699316a9691975a8",
    "table_index": 110
  },
  {
    "id": "ADVDATA/SCRIPT/S0130.SBX#0111",
    "before": {
      "source": "位於葦亜握斡姐亜歌亜蔭遠……//以伊亜餓塊穐亜鮎叡瑛一葦唄胤//扱穐易亜涯闇鞄亜頴挨叡苅引．"
    },
    "after": {
      "source": "考えがまとまらないな……//演出の方針についてだけでも、//かえでさんに相談してみるか。"
    },
    "reference": "research/legacy/original_txt/ADVDATA/SCRIPT/S0130.txt",
    "reference_sha256": "5610bad5c832c446165b3b272e427ef2e268977be11f90df699316a9691975a8",
    "table_index": 111
  },
  {
    "id": "ADVDATA/SCRIPT/S0130.SBX#0114",
    "before": {
      "source": "厩瓦謂絢綾，亜扱穐易亜涯．//迂迂姐営亥易衣，//郁乾亜噂云衛逸衣？"
    },
    "after": {
      "source": "すみません、かえでさん。//大神ですけど、//すこしよろしいですか？"
    },
    "reference": "research/legacy/original_txt/ADVDATA/SCRIPT/S0130.txt",
    "reference_sha256": "5610bad5c832c446165b3b272e427ef2e268977be11f90df699316a9691975a8",
    "table_index": 114
  },
  {
    "id": "ADVDATA/SCRIPT/S0130.SBX#0115",
    "before": {
      "source": "慰，亜迂迂姐営亜駅．//侃胃芦衛絢引亜飲淫鰻．"
    },
    "after": {
      "source": "あ、大神くん。//開いてるから、どうぞ。"
    },
    "reference": "research/legacy/original_txt/ADVDATA/SCRIPT/S0130.txt",
    "reference_sha256": "5610bad5c832c446165b3b272e427ef2e268977be11f90df699316a9691975a8",
    "table_index": 115
  },
  {
    "id": "ADVDATA/SCRIPT/S0130.SBX#0116",
    "before": {
      "source": "煙冠亜鞍葦押？//寒姐亜員刊韻斡唄胤？"
    },
    "after": {
      "source": "どうしたの？//なにか悩みごと？"
    },
    "reference": "research/legacy/original_txt/ADVDATA/SCRIPT/S0130.txt",
    "reference_sha256": "5610bad5c832c446165b3b272e427ef2e268977be11f90df699316a9691975a8",
    "table_index": 116
  },
  {
    "id": "ADVDATA/SCRIPT/S0130.SBX#0117",
    "before": {
      "source": "遠……//葦碍亜煙鮎……淫馨粟//以伊異宇亜員刊葦亜獲瑛……"
    },
    "after": {
      "source": "はい……//今度の舞台……どうやって//演出しようかと思って……"
    },
    "reference": "research/legacy/original_txt/ADVDATA/SCRIPT/S0130.txt",
    "reference_sha256": "5610bad5c832c446165b3b272e427ef2e268977be11f90df699316a9691975a8",
    "table_index": 117
  },
  {
    "id": "ADVDATA/SCRIPT/S0130.SBX#0118",
    "before": {
      "source": "円勘乙吋……淫胃果亜応渦遠．//淫馨粟亜葦押壱為//閏威勧宇亜撹葦宇……"
    },
    "after": {
      "source": "そうね……難しい問題ね。//どうやって、お話を//見せていくかだけど……"
    },
    "reference": "research/legacy/original_txt/ADVDATA/SCRIPT/S0130.txt",
    "reference_sha256": "5610bad5c832c446165b3b272e427ef2e268977be11f90df699316a9691975a8",
    "table_index": 118
  },
  {
    "id": "ADVDATA/SCRIPT/S0130.SBX#0119",
    "before": {
      "source": "案瑛為亜鉛員//鵜加安亜巻衛胃亜暗鯵//逢亜怨逢延……"
    },
    "after": {
      "source": "許しを受けて、//人を信じようとする//ジャン・バルジャンと……"
    },
    "reference": "research/legacy/original_txt/ADVDATA/SCRIPT/S0130.txt",
    "reference_sha256": "5610bad5c832c446165b3b272e427ef2e268977be11f90df699316a9691975a8",
    "table_index": 119
  },
  {
    "id": "ADVDATA/SCRIPT/S0130.SBX#0120",
    "before": {
      "source": "喚一安亜巻員亜堪臆暗粟亜禾慰姐鯵//甥奄赫挨亜姦挨亜餓仮延挨亜鮎較．//葦完亜暗吋挨亜官衛或亜寛員……"
    },
    "after": {
      "source": "法だけを信じて、厳格に生きる//ジャベールの生き方の対立。//これを一本の柱として……"
    },
    "reference": "research/legacy/original_txt/ADVDATA/SCRIPT/S0130.txt",
    "reference_sha256": "5610bad5c832c446165b3b272e427ef2e268977be11f90df699316a9691975a8",
    "table_index": 120
  },
  {
    "id": "ADVDATA/SCRIPT/S0130.SBX#0121",
    "before": {
      "source": "綾窺亜暗吋鯵……円愛粟，//円亜燕飲葦亜姐逢//鎧営或介沿鴬亜完或亜暗鯵亜干亜淫恩？"
    },
    "after": {
      "source": "もう一本は……そうね、//あの子たちが一番//興味を引かれたものにするのは？"
    },
    "reference": "research/legacy/original_txt/ADVDATA/SCRIPT/S0130.txt",
    "reference_sha256": "5610bad5c832c446165b3b272e427ef2e268977be11f90df699316a9691975a8",
    "table_index": 121
  },
  {
    "id": "ADVDATA/SCRIPT/S0130.SBX#0122",
    "before": {
      "source": "……円愛遠衣．"
    },
    "after": {
      "source": "……そうですね。"
    },
    "reference": "research/legacy/original_txt/ADVDATA/SCRIPT/S0130.txt",
    "reference_sha256": "5610bad5c832c446165b3b272e427ef2e268977be11f90df699316a9691975a8",
    "table_index": 122
  },
  {
    "id": "ADVDATA/SCRIPT/S0130.SBX#0123",
    "before": {
      "source": "越渦娃挨亜幹浬亜葦押壱亥姐衣？"
    },
    "after": {
      "source": "コゼットの結婚の話ですか？"
    },
    "reference": "research/legacy/original_txt/ADVDATA/SCRIPT/S0130.txt",
    "reference_sha256": "5610bad5c832c446165b3b272e427ef2e268977be11f90df699316a9691975a8",
    "table_index": 123
  },
  {
    "id": "ADVDATA/SCRIPT/S0130.SBX#0124",
    "before": {
      "source": "鞄吋赫恰穐挨亜患感亜葦押壱亥姐衣？"
    },
    "after": {
      "source": "テナルディエの強欲の話ですか？"
    },
    "reference": "research/legacy/original_txt/ADVDATA/SCRIPT/S0130.txt",
    "reference_sha256": "5610bad5c832c446165b3b272e427ef2e268977be11f90df699316a9691975a8",
    "table_index": 124
  },
  {
    "id": "ADVDATA/SCRIPT/S0130.SBX#0125",
    "before": {
      "source": "営斡慣亜溢憾挨亜乙陰亜葦押壱亥姐衣？"
    },
    "after": {
      "source": "ミリエル司教の救済の話ですか？"
    },
    "reference": "research/legacy/original_txt/ADVDATA/SCRIPT/S0130.txt",
    "reference_sha256": "5610bad5c832c446165b3b272e427ef2e268977be11f90df699316a9691975a8",
    "table_index": 125
  },
  {
    "id": "ADVDATA/SCRIPT/S0130.SBX#0127",
    "before": {
      "source": "越渦娃挨亜幹浬亜葦押壱亥姐衣？//鵜嘘唄亜換葦敢亜綾飲//解慰闇綾員亜沿鴬亜逢旭葦骸．"
    },
    "after": {
      "source": "コゼットの結婚の話ですか？//さくらくんたちが、//好きだと言ったシーンですよね。"
    },
    "reference": "research/legacy/original_txt/ADVDATA/SCRIPT/S0130.txt",
    "reference_sha256": "5610bad5c832c446165b3b272e427ef2e268977be11f90df699316a9691975a8",
    "table_index": 127
  },
  {
    "id": "ADVDATA/SCRIPT/S0130.SBX#0128",
    "before": {
      "source": "柑……円粟亜解姻遠．//越渦娃鰻亜烏斡閲稲挨亜幹浬鴛//桓外衛或亜姐崖闇亜営運絢引．"
    },
    "after": {
      "source": "うん……それがいいわね。//コゼットとマリユスの結婚は//希望に満ちた未来ですもの。"
    },
    "reference": "research/legacy/original_txt/ADVDATA/SCRIPT/S0130.txt",
    "reference_sha256": "5610bad5c832c446165b3b272e427ef2e268977be11f90df699316a9691975a8",
    "table_index": 128
  },
  {
    "id": "ADVDATA/SCRIPT/S0130.SBX#0129",
    "before": {
      "source": "鞄吋赫恰穐挨亜患感亜葦押壱亥姐衣？//稲営悦亜換鴛//雨棺暗綾員亜沿蟹鯵易衣．"
    },
    "after": {
      "source": "テナルディエの強欲の話ですか？//すみれくんが、//不愉快だと言ってましたけど。"
    },
    "reference": "research/legacy/original_txt/ADVDATA/SCRIPT/S0130.txt",
    "reference_sha256": "5610bad5c832c446165b3b272e427ef2e268977be11f90df699316a9691975a8",
    "table_index": 129
  },
  {
    "id": "ADVDATA/SCRIPT/S0130.SBX#0130",
    "before": {
      "source": "款葦亜雨棺闇亜完//鞄烏或亜寛安亜萎衣鯵//虻姻骸．"
    },
    "after": {
      "source": "わざわざ、不愉快なものを//テーマにする必要は//ないでしょう。"
    },
    "reference": "research/legacy/original_txt/ADVDATA/SCRIPT/S0130.txt",
    "reference_sha256": "5610bad5c832c446165b3b272e427ef2e268977be11f90df699316a9691975a8",
    "table_index": 130
  },
  {
    "id": "ADVDATA/SCRIPT/S0130.SBX#0131",
    "before": {
      "source": "円愛粟……//越渦娃鰻亜烏斡閲稲挨//幹浬亜葦押壱鯵亜淫恩？"
    },
    "after": {
      "source": "そうね……//コゼットとマリユスの//結婚の話はどう？"
    },
    "reference": "research/legacy/original_txt/ADVDATA/SCRIPT/S0130.txt",
    "reference_sha256": "5610bad5c832c446165b3b272e427ef2e268977be11f90df699316a9691975a8",
    "table_index": 131
  },
  {
    "id": "ADVDATA/SCRIPT/S0130.SBX#0132",
    "before": {
      "source": "葦亜逢旭，//鵜嘘唄亜換葦敢亜綾飲亜慰溢//烏顎穐亜飲淫沿蟹歓慰？"
    },
    "after": {
      "source": "このシーン、//さくらたちがとても//気に入っていたでしょ？"
    },
    "reference": "research/legacy/original_txt/ADVDATA/SCRIPT/S0130.txt",
    "reference_sha256": "5610bad5c832c446165b3b272e427ef2e268977be11f90df699316a9691975a8",
    "table_index": 132
  },
  {
    "id": "ADVDATA/SCRIPT/S0130.SBX#0133",
    "before": {
      "source": "円汗，//越渦娃鰻亜烏斡閲稲挨亜幹浬亜葦押壱為//漢亜綾窺亜官衛或亜寛安粟衣．"
    },
    "after": {
      "source": "それじゃあ、//コゼットとマリユスの結婚の話を//もう一本の柱にします。"
    },
    "reference": "research/legacy/original_txt/ADVDATA/SCRIPT/S0130.txt",
    "reference_sha256": "5610bad5c832c446165b3b272e427ef2e268977be11f90df699316a9691975a8",
    "table_index": 133
  },
  {
    "id": "ADVDATA/SCRIPT/S0130.SBX#0134",
    "before": {
      "source": "円粟亜解姻遠．//柑，亜解鴛亜煙鮎姐//澗亜潅亜温鴛易．"
    },
    "after": {
      "source": "それがいいわね。//うん、いい舞台に//なりそうじゃないの。"
    },
    "reference": "research/legacy/original_txt/ADVDATA/SCRIPT/S0130.txt",
    "reference_sha256": "5610bad5c832c446165b3b272e427ef2e268977be11f90df699316a9691975a8",
    "table_index": 134
  }
]
