[
  {
    "id": "ADVDATA/SCRIPT/S0220.SBX#0109",
    "before": {
      "source": "暗慰……迂確鴛亜鴎亜惟以胤亜閏員//円斡園堰胤亜迂員//握撹亜葦拡畏拡亜鞍葦亜我泳遠……"
    },
    "after": {
      "source": "はぁ……今日は能を見たり、//グリシーヌが来たり、//本当にいろいろあったなぁ……"
    },
    "reference": "research/legacy/original_txt/ADVDATA/SCRIPT/S0220.txt",
