  },
  {
    "id": "ADVDATA/SCRIPT/S0220.SBX#0110",
    "before": {
      "source": "円斡園堰敢亜環壱暗員亜甘宇一……//歌亜蔭姻綾……迂確鴛亜葦一亜甥甥．//漢……咽鞍亜暗宇……"
    },
    "after": {
      "source": "グリシーヌと話がしたいけど……//ダメだ……今日はもう寝よう。//また……明日だな……"
    },
    "reference": "research/legacy/original_txt/ADVDATA/SCRIPT/S0220.txt",
    "reference_sha256": "e61cd38b0f439e0a9fa725157af4e13abfe3f3fc9c945145fd2a53f365fa88bf",
    "table_index": 110
