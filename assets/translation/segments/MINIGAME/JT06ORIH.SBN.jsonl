{"id": "MINIGAME/JT06ORIH.SBN#0012", "file": "MINIGAME/JT06ORIH.SBN", "offset": 4522, "capacity": 14, "raw_hex": "f491f0a5f186f469f0b8f0cf8144", "text": "축하드립니다．", "baseline_text": "축하드립니다．", "kind": "ascr", "review": "교차 검토 필요", "source": "おめでとうございます。", "pointer_offset": 3868}
