[
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 923,
  "texture": 0,
  "text": "저…… 오오가미 소위님이세요?/저, 신구지 사쿠라라고 해요.",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0923_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 924,
  "texture": 0,
  "text": "저……/살아 있어도 괜찮은 건가요?",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0924_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 925,
  "texture": 0,
  "text": "귀왕을 쓰러뜨리면……/아버지의 혼이 돌아온다./그렇게 여겨져요.",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0925_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 926,
  "texture": 0,
  "text": "저……/아버지와, 싸우겠어요.",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0926_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 927,
  "texture": 0,
  "text": "흐응…… 오오가미 씨는,/꽤 바람둥이시네요……",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0927_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 928,
  "texture": 0,
  "text": "열두 시까지,/마법의 시간을 주세요……",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0928_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 929,
  "texture": 0,
  "text": "여보…… 아침이에요……/라니……",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0929_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 930,
  "texture": 0,
  "text": "평범한 여자아이처럼,/좋아하는 사람과 있고 싶어!/……저, 욕심쟁이인가요?",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0930_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 931,
  "texture": 0,
  "text": "오오가미 씨…… 앞으로도……/쭉 곁에 있어 주세요……",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0931_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 932,
  "texture": 0,
  "text": "거기 떨어뜨린 포크……/새것으로/바꿔 주시지 않겠어요?",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0932_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 933,
  "texture": 0,
  "text": "제가 소중히 여기는/모든 것을 위해 싸우겠어요!",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0933_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 934,
  "texture": 0,
  "text": "남자분과 단둘이 첫 참배라니……/저, 처음이에요.",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0934_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 935,
  "texture": 0,
  "text": "신데렐라에게 걸린 마법은,/열두 시에 풀려 버리지만……/어째서인지, 아세요?",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0935_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 936,
  "texture": 0,
  "text": "……할아버님./저……/제국화격단으로 돌아가겠어요.",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0936_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 937,
  "texture": 0,
  "text": "……그렇겠지요./소위는, 화조의 대장이시니까요……",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0937_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 938,
  "texture": 0,
  "text": "아버님, 어머님……/다녀오겠습니다.",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0938_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 939,
  "texture": 0,
  "text": "저는 제극의 톱스타!/빛나지 않으면 안 된답니다!!",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0939_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 940,
  "texture": 0,
  "text": "둘이서, 함께 있을 수 있음을/솔직하게 감사하고 싶어요……",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0940_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 941,
  "texture": 0,
  "text": "당신이 제격에 배속된/오오가미 소위인가요?",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0941_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 942,
  "texture": 0,
  "text": "의상이 귀여워서……/그만…… 저도 모르게……",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0942_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 943,
  "texture": 0,
  "text": "대장…… 대장은,/제가 반드시 지킬게요.",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0943_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 944,
  "texture": 0,
  "text": "하나 충고해 두죠./여자 얼굴을 빤히 보지 말 것!",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0944_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 945,
  "texture": 0,
  "text": "저는……/살아 있는 기쁨을……/감사했어요.",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0945_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 946,
  "texture": 0,
  "text": "정말, 대장……/놀리지 마세요!",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0946_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 947,
  "texture": 0,
  "text": "당신은 대장 실격이에요!",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0947_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 948,
  "texture": 0,
  "text": "나를 구하러 오다니……/바보야, 당신들……",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0948_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 949,
  "texture": 0,
  "text": "……대장,/저를…… 지켜 주실 건가요?",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0949_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 950,
  "texture": 0,
  "text": "어쩐지 낯짝이 좋더라니./……마음에 들었어.",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0950_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 951,
  "texture": 0,
  "text": "오키나와서 오던 배가 가라앉아서./헤엄쳐 왔다니까.",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0951_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 952,
  "texture": 0,
  "text": "나 같은 건……/힘자랑만 할 줄 아는/무뚝뚝한 여자인걸……",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0952_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 953,
  "texture": 0,
  "text": "나라면 할 수 있을 거야!/이번에야말로, 아버지를 넘어서겠어!!",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0953_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 954,
  "texture": 0,
  "text": "그럼 대장,/우선 대련부터 해 볼까.",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0954_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 955,
  "texture": 0,
  "text": "내 몸에 붕대 감는 건/자주 하는데……/남한테 감는 건 어렵네.",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0955_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 956,
  "texture": 0,
  "text": "잠깐 기다려어—!!/그 맞선!",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0956_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 957,
  "texture": 0,
  "text": "아버지…… 내 대장,/멋지지? 강해 보이지?",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0957_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 958,
  "texture": 0,
  "text": "대장이 이렇게 해 주면……/마음이 편해져……/어쩐지, 굉장히 안심이 돼……",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0958_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 959,
  "texture": 0,
  "text": "이 애는 곰돌이 장 폴!/사이좋게 지내 줘!!",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0959_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 960,
  "texture": 0,
  "text": "아이리스, 어린애 아니란 말야!/오빠 같은 건…… 정말 싫어!!",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0960_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 961,
  "texture": 0,
  "text": "아이리스, 화나면/무섭단 말이야—!!",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0961_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 962,
  "texture": 0,
  "text": "두부 모서리에 머리 박고/울어 버려—!!",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0962_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 963,
  "texture": 0,
  "text": "저기, 오빠./내일, 아이리스랑 데이트하자!",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0963_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 964,
  "texture": 0,
  "text": "오빠는…… 응큼해!",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0964_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 965,
  "texture": 0,
  "text": "그럼…… 뽀뽀해 줘!",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0965_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 966,
  "texture": 0,
  "text": "아이리스……/혼자는 싫어……",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0966_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 967,
  "texture": 0,
  "text": "아이리스…… 좋아해?",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0967_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 968,
  "texture": 0,
  "text": "내 이름은 이홍란이라 캅니더./제격・하나야시키 지부에서 오늘부로/긴자 본부로 전속됐습니더.",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0968_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 969,
  "texture": 0,
  "text": "괜찮다!/이런 일도 있을까 싶어서,/수리 공구는 늘 갖고 댕긴다 카이!",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0969_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 970,
  "texture": 0,
  "text": "내 바이크 뒤에 탄 남자는,/니가 처음이데이!",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0970_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 971,
  "texture": 0,
  "text": "내, 한 번쯤,/인체 개조, 해 보고 싶었다 아이가!",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0971_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 972,
  "texture": 0,
  "text": "오오가미 씨 신무에는,/내 사랑이 듬뿍 담겨 있다 카이!",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0972_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 973,
  "texture": 0,
  "text": "안녕하십니꺼아!/홍야코라예~!!",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0973_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 974,
  "texture": 0,
  "text": "그래…… 내한테는,/화조 동료들이……/소중한 가족이 있었던 기라.",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0974_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 975,
  "texture": 0,
  "text": "그래도, 내 발명의 원점은……/이 시계인 기라.",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0975_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 976,
  "texture": 0,
  "text": "이러고 있으믄, 내……/억수로 맘이 편하데이……",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0976_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 977,
  "texture": 0,
  "text": "차오!/솔레타・오리히메예~요./오리히메라고 불러 주세~요.",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0977_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 978,
  "texture": 0,
  "text": "그러니까, 처음에/한마디 해 둘게~요./바~보!",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0978_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 979,
  "texture": 0,
  "text": "역시, 일본 남자는/무례하고 경박하고 최악이에~요.",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0979_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 980,
  "texture": 0,
  "text": "무대 위에서 주고받는 대사는/인스피레이션이 중요하답니다.",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0980_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 981,
  "texture": 0,
  "text": "소위님……/정말 와 주셨군요……/그래도…… 조금 지각이에~요.",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0981_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 982,
  "texture": 0,
  "text": "파파…… 저는 갈게요./소중한 사람을 위해……",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0982_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 983,
  "texture": 0,
  "text": "자, 너……/동료 별들 곁으로 돌아가렴……",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0983_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 984,
  "texture": 0,
  "text": "좀 더 일찍,/소위님을 만나고 싶었어……/그랬다면……",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0984_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 985,
  "texture": 0,
  "text": "언제까지나 둘이/함께 있을 수 있도록……/제가 거는 주문이에~요.",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0985_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 986,
  "texture": 0,
  "text": "그리고……/나는 「레니」라고 불러도 돼.",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0986_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 987,
  "texture": 0,
  "text": "나는……/무엇을 위해 싸우는 거야?",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0987_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 988,
  "texture": 0,
  "text": "……알았어.",
  "remake": "assets/images/remake/quotes/ADVDATA/CG_ALL1.DAT/0988_0000.png"
 },
 {
  "source": "ADVDATA/CG_ALL1.DAT",
  "block": 989,
  "texture": 0,
  "text": "다녀왔어, 대장……/다녀왔어…… 나의 동료들……",
